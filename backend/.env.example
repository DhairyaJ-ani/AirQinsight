SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ML engine
EE_PROJECT=internal-hackathon-509815
OPENAQ_API_KEY=

# Reports: optional Gemini narrative (one call per report, cached). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_DAILY_LIMIT=40

# Local demo only: use the web app on this machine without logging in (never on a server)
LOCAL_DEMO_MODE=true

# Presentation mode: never call Earth Engine or Gemini; serve stored runs, the last globe snapshot and
# cached narratives. Prepare first with: uv run python -m ml_engine.prewarm --globe --report CITY:DATE --ai
# ML_ENGINE_OFFLINE=true
